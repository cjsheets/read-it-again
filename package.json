{
  "name": "read-it-again",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bookshelf": "pnpm --filter @read-it-again/local-api bookshelf --",
    "build": "pnpm -r --if-present build",
    "check:web-boundary": "node scripts/check-web-boundary.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:web-boundary",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:browser": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
